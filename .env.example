# Copy to .env and fill in your values.
# Real environment variables always take precedence over this file.

# Your Immich server (required)
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=your-immich-api-key

# Google Cloud Vision API key (required)
# Create a project at https://console.cloud.google.com, enable the
# Cloud Vision API, and create an API key. Landmark detection has a
# free tier of 1000 units/month.
GOOGLE_VISION_API_KEY=your-vision-api-key

# SerpApi key (optional) - enables the Google Lens fallback for images
# that Cloud Vision does not recognize. https://serpapi.com
#SERPAPI_KEY=your-serpapi-key

# Contact email for the Nominatim geocoding usage policy (optional but polite)
#NOMINATIM_EMAIL=you@example.com
